# Copie para .env e ajuste. O .env é ignorado pelo git e nunca é commitado.
#
#   cp .env.example .env
#
# Os valores abaixo são os padrões usados pelo compose quando o .env não existe,
# e servem para desenvolvimento local. Em produção, nenhum deles se repete.

POSTGRES_DB=agendaia
POSTGRES_USER=agendaia
POSTGRES_PASSWORD=agendaia
POSTGRES_PORT=5432
