<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<groupId>com.agendaia</groupId>
	<artifactId>agendaia</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>AgendaIA</name>
	<description>SaaS de agendamento para barbearias, salões e profissionais que atendem por horário</description>

	<!--
		Modular Monolith: um módulo por contexto delimitado (ver ADR 0001).

		A ordem abaixo é a ordem de dependência, das fundações para a composição.
		O Maven recalcula a ordem real a partir das dependências declaradas; esta
		listagem existe para quem lê.
	-->
	<modules>
		<module>agendaia-shared-kernel</module>
		<module>agendaia-platform</module>
		<module>agendaia-organization</module>
		<module>agendaia-catalog</module>
		<module>agendaia-scheduling</module>
		<module>agendaia-customer</module>
		<module>agendaia-bootstrap</module>
	</modules>

	<properties>
		<java.version>21</java.version>
	</properties>

	<dependencies>
		<!--
			Lombok é processamento em tempo de compilação, não framework: pode
			existir até no domínio puro sem violar a regra de dependência.
			Optional para não vazar como dependência transitiva do jar.
		-->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
	</dependencies>

	<build>
		<!-- Herdado por todos os módulos filhos. -->
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
