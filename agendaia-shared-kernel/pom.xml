<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.agendaia</groupId>
		<artifactId>agendaia</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>

	<artifactId>agendaia-shared-kernel</artifactId>
	<name>AgendaIA :: Shared Kernel</name>
	<description>Tipos puros compartilhados por todos os contextos</description>

	<!--
		ZERO dependências de produção, por decisão.

		Este módulo não tem Spring, JPA, Jackson nem nada além do JDK. Se algum
		dia uma dependência precisar entrar aqui, isso é sinal de que o tipo em
		questão não pertence ao shared kernel.

		Testes usam JUnit e AssertJ diretos, não spring-boot-starter-test: trazer
		o contexto Spring para testar um value object seria contradizer o motivo
		de este módulo existir.
	-->
	<dependencies>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

</project>
